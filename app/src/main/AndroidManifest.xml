<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GrapheneOS-friendly: no location, no GMS. Manual ZIP code entry only. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- POST_NOTIFICATIONS (API 33+): declared so runtime notification
         permission can be requested at runtime; no GMS, no location
         permission is used. Exactly one declaration must remain. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Family theme-sync. Do NOT <permission>-declare THEME_SYNC: this app
         is signed with a different key than XX-Launcher, and a second
         declaration is INSTALL_FAILED_DUPLICATE_PERMISSION. The receiver is
         still gated by android:permission so only the launcher can send. -->
    <uses-permission android:name="com.piercingxx.xxlauncher.permission.THEME_SYNC" />

    <application
        android:name=".WeatherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XXWeather">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.CompactWeatherWidget"
            android:exported="false"
            android:label="@string/widget_compact_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compact_info" />
        </receiver>

        <receiver
            android:name=".widget.WideWeatherWidget"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>

        <receiver
            android:name=".theme.ThemeSyncReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.piercingxx.xxlauncher.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="xx.launcher.THEME_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
